{
  "buildCommand": "cd client-budokan && pnpm run build",
  "outputDirectory": "client-budokan/dist",
  "installCommand": "cd client-budokan && pnpm install --frozen-lockfile=false",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' http://localhost:3000 http://localhost:3001 https://*.vercel.app"
        }
      ]
    }
  ]
}
