# Server-only paymaster configuration. PAYMASTER_SECRET_KEY belongs in the
# deployment platform's secret manager and must never be committed.
SOLANA_DEVNET_RPC_URL=https://rpc.magicblock.app/devnet
PAYMASTER_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
PAYMASTER_SECRET_KEY=<set-in-secret-manager>
ZKUBE_PAYMASTER_PUBLIC_KEY=CNhMPp5p3ViMEzBpeRRjXX1G672rwxHkyNG4gVRN7SgY
PAYMASTER_ALLOWED_ORIGINS=https://zkube-solana.vercel.app,https://*.vercel.app
PAYMASTER_MAX_CONCURRENT_SUBMISSIONS=8
# Development-only alternative used by `pnpm dev`; rejected in production.
PAYMASTER_KEYPAIR_PATH=../.devnet/zkube-paymaster.json

# Autonomous Fly worker. It owns only the keeper signer and calls the public
# paymaster HTTPS endpoint; PAYMASTER_SECRET_KEY must never be set on this app.
KEEPER_ENABLED=false
KEEPER_SECRET_KEY=
ZKUBE_KEEPER_PUBLIC_KEY=6JuZiVic8yUipamYyzWvVUcTdD8kbpdpv79CBGjm4XTg
PAYMASTER_ENDPOINT=https://zkube-solana-devnet-paymaster.fly.dev/api/paymaster
KEEPER_INTERVAL_MS=300000
KEEPER_MAX_WRITES=8
MIN_PAYMASTER_LAMPORTS=1500000000

# Sanitized deployment-manifest identity — OPTIONAL operator provenance
# attestation via `pnpm chain:manifest --require-approved`. This is NO LONGER a
# Vercel build gate: the web build runs plain `pnpm run build` (see
# docs/operations.md → Web deployment). Values below are placeholders; the
# current live program fingerprint/SBF are recorded in STATUS.md.
ZKUBE_DEPLOYMENT_MANIFEST=<approved-sanitized-manifest.json>
ZKUBE_CLUSTER=devnet
ZKUBE_APPROVAL_STATUS=<candidate-or-approved>
ZKUBE_APPROVAL_FINGERPRINT=<approved-16-hex-fingerprint>
ZKUBE_APPROVED_AT=<iso-timestamp>
ZKUBE_APPROVAL_EVIDENCE_SHA256=<sanitized-proof-sha256>
ZKUBE_PROGRAM_ARTIFACT_SHA256=<current-sbf-sha256-see-STATUS.md>
ZKUBE_DEPLOYMENT_SIGNATURE=<latest-approved-upgrade-signature>
ZKUBE_DEPLOYED_AT=<latest-approved-upgrade-iso-timestamp>
ZKUBE_PAYMENT_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
ZKUBE_PAYMENT_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
ZKUBE_TEAM_VAULT=8nBxUByKv1PiC7GNzxZYkCBXeLJhg2rVqpobvQeLFivG
ZKUBE_PAYMASTER_VAULT=5HsAQ4ZZ3kExamfCiap6mT88DAmkVW8J7v7s5rBpga8Y
ZKUBE_TREASURY_VAULT=34gQiFnfFnfav5VmzFg15EqoEBtW2oi25wVNv36TsNAH
