# Keeper-only Fly configuration. Player transactions are paid from the
# connected wallet's owner-funded device session.
SOLANA_DEVNET_RPC_URL=https://rpc.magicblock.app/devnet
SOLANA_EXPECTED_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
KEEPER_ENABLED=false
KEEPER_SECRET_KEY=
ZKUBE_KEEPER_PUBLIC_KEY=6JuZiVic8yUipamYyzWvVUcTdD8kbpdpv79CBGjm4XTg
KEEPER_INTERVAL_MS=300000
KEEPER_MAX_WRITES=8
MIN_KEEPER_LAMPORTS=10000000

# Sanitized deployment-manifest identity. Production Vercel builds require the
# exact committed manifest and artifact hash below. The remaining values are
# operator inputs for generating or validating a manifest from the environment.
ZKUBE_DEPLOYMENT_MANIFEST=deployment/devnet-v4.json
ZKUBE_CLUSTER=devnet
ZKUBE_APPROVAL_STATUS=<candidate-or-approved>
ZKUBE_APPROVAL_FINGERPRINT=<approved-16-hex-fingerprint>
ZKUBE_APPROVED_AT=<iso-timestamp>
ZKUBE_APPROVAL_EVIDENCE_SHA256=<sanitized-proof-sha256>
ZKUBE_PROGRAM_ARTIFACT_SHA256=bbd69fc95d964d159fdb390810ac2b432f47540c85ff9d1ccd5cee0b6c8b0cf5
ZKUBE_DEPLOYMENT_SIGNATURE=<latest-approved-upgrade-signature>
ZKUBE_DEPLOYED_AT=<latest-approved-upgrade-iso-timestamp>
ZKUBE_TEAM_DESTINATION=8nBxUByKv1PiC7GNzxZYkCBXeLJhg2rVqpobvQeLFivG
ZKUBE_TREASURY_DESTINATION=9E69kpXv6qrkBgJvJGr2s7NWji6W9voSJibYn8vy8Fxu
ZKUBE_REWARD_VAULT=FpRj7daRRbcZmGLMHRHpP6qnXuGu8XKABuiNtuBs1oTV
ZKUBE_PROTOCOL_AUTHORITY=HmCGfPTW2ahuNySTddvbQpJxutDUhjMbR9j8ekFzHQ5b
