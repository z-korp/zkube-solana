ZKUBE_DAILY_RULES_VERSION=1

# Optional signer-free readiness/monitoring thresholds. These are operational
# alert policy, not on-chain entitlement or mutable application state.
ZKUBE_READ_RPC_URL=https://rpc.magicblock.app/devnet
ZKUBE_EXPECTED_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
ZKUBE_LOOKBACK_DAYS=120
ZKUBE_CLAIM_WARNING_HOURS=72

# Operator-only Devnet deployment tooling. These paths remain local and are
# never included in a manifest or web environment. Dry-run is the default.
ZKUBE_BASE_RPC=https://rpc.magicblock.app/devnet
ZKUBE_ANCHOR_WORKSPACE=..
ZKUBE_PROGRAM_ARTIFACT=../target/deploy/solana.so
ZKUBE_DEPLOY_MODE=upgrade
ZKUBE_PROGRAM_KEYPAIR=../.devnet/zkube-v3-program-keypair.json
ZKUBE_PROGRAM_BUFFER_KEYPAIR=../.devnet/zkube-program-buffer.json
ZKUBE_DEPLOYER_KEYPAIR=<funded-devnet-deployer-keypair>
ZKUBE_UPGRADE_AUTHORITY_KEYPAIR=../.devnet/zkube-upgrade-authority.json
# ZKUBE_DEPLOY=1
# ZKUBE_DEPLOY_APPROVAL=<exact-preview-fingerprint>

# Operator-only staged Devnet protocol bootstrap. Dry-run and unsigned
# simulation are the defaults; each stage requires a separate approval.
ZKUBE_BOOTSTRAP_STAGE=custody
ZKUBE_BOOTSTRAP_FUNDER_KEYPAIR=../../cycling-sim/.devnet/deployer.json
ZKUBE_PROTOCOL_AUTHORITY_KEYPAIR=../.devnet/zkube-governance-authority.json
ZKUBE_TEAM_VAULT_KEYPAIR=../.devnet/zkube-team-vault.json
ZKUBE_TREASURY_VAULT_KEYPAIR=../.devnet/zkube-treasury-vault-v2.json
# ZKUBE_BOOTSTRAP_SEND=1
# ZKUBE_BOOTSTRAP_APPROVAL=<exact-stage-fingerprint>
