require "fileutils"

APP_IDENTIFIER = "com.zkorp.zkube"
IOS_PROJECT = File.expand_path("../ios/App/App.xcodeproj", __dir__)
ANDROID_PROJECT = File.expand_path("../android", __dir__)
MOBILE_OUTPUT = File.expand_path("../build/mobile", __dir__)

def require_environment!(*names)
  missing = names.select { |name| ENV[name].to_s.empty? }
  UI.user_error!("Missing CI environment: #{missing.join(', ')}") unless missing.empty?
end

def require_release_approval!
  return if ENV["MOBILE_RELEASE_APPROVED"] == "true"

  UI.user_error!("MOBILE_RELEASE_APPROVED=true is required for a release lane")
end

def app_store_key
  require_environment!(
    "APP_STORE_CONNECT_KEY_ID",
    "APP_STORE_CONNECT_ISSUER_ID",
    "APP_STORE_CONNECT_PRIVATE_KEY_BASE64",
  )
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY_BASE64"),
    is_key_content_base64: true,
  )
end

platform :ios do
  private_lane :signed_archive do
    require_environment!(
      "IOS_CERTIFICATE_PATH",
      "IOS_CERTIFICATE_PASSWORD",
      "IOS_PROVISIONING_PROFILE_PATH",
      "IOS_PROVISIONING_PROFILE_NAME",
      "IOS_TEAM_ID",
    )
    setup_ci if ENV["CI"]
    import_certificate(
      certificate_path: ENV.fetch("IOS_CERTIFICATE_PATH"),
      certificate_password: ENV.fetch("IOS_CERTIFICATE_PASSWORD"),
    )
    install_provisioning_profile(
      path: ENV.fetch("IOS_PROVISIONING_PROFILE_PATH"),
    )
    build_app(
      project: IOS_PROJECT,
      scheme: "App",
      clean: true,
      export_method: "app-store",
      output_directory: File.join(MOBILE_OUTPUT, "ios"),
      output_name: "zkube.ipa",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => ENV.fetch("IOS_PROVISIONING_PROFILE_NAME"),
        },
      },
      xcargs: [
        "DEVELOPMENT_TEAM=#{ENV.fetch('IOS_TEAM_ID')}",
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('IOS_BUILD_NUMBER', '1')}",
        "PROVISIONING_PROFILE_SPECIFIER='#{ENV.fetch('IOS_PROVISIONING_PROFILE_NAME')}'",
      ].join(" "),
    )
  end

  desc "Build and upload the signed beta to TestFlight"
  lane :beta do
    key = app_store_key
    signed_archive
    upload_to_testflight(
      api_key: key,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Build and stage an App Store release without automatic review or release"
  lane :release do
    require_release_approval!
    key = app_store_key
    signed_archive
    upload_to_app_store(
      api_key: key,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
    )
  end
end

platform :android do
  private_lane :signed_apk do
    flavor = ENV.fetch("ZKUBE_ANDROID_FLAVOR", "solana")
    UI.user_error!("Android flavor must be solana or store") unless ["solana", "store"].include?(flavor)
    signing_prefix = flavor == "store" ? "ZKUBE_ANDROID_STORE" : "ZKUBE_ANDROID"
    require_environment!(
      "#{signing_prefix}_KEYSTORE_PATH",
      "#{signing_prefix}_KEYSTORE_PASSWORD",
      "#{signing_prefix}_KEY_ALIAS",
      "#{signing_prefix}_KEY_PASSWORD",
    )
    gradle(
      project_dir: ANDROID_PROJECT,
      tasks: ["clean", "assemble#{flavor.capitalize}Release"],
    )
    apk_pattern = File.join(
      ANDROID_PROJECT,
      "app",
      "build",
      "outputs",
      "apk",
      flavor,
      "release",
      "*.apk",
    )
    apks = Dir[apk_pattern].reject { |path| path.end_with?("-unsigned.apk") }
    UI.user_error!("Gradle did not produce one #{flavor} release APK") unless apks.length == 1
    apk = apks.first
    android_home = ENV.fetch("ANDROID_HOME")
    apksigner = Dir[File.join(android_home, "build-tools", "*", "apksigner")].sort.last
    UI.user_error!("Android SDK apksigner is missing") if apksigner.to_s.empty?
    sh(apksigner, "verify", "--verbose", apk)
    destination = File.join(MOBILE_OUTPUT, "android", "zkube.apk")
    FileUtils.mkdir_p(File.dirname(destination))
    FileUtils.cp(apk, destination)
  end

  desc "Build the signed APK used for dApp Store review"
  lane :beta do
    signed_apk
  end

  desc "Build the signed release APK; publishing remains a separate approval"
  lane :release do
    require_release_approval!
    signed_apk
  end
end
