{
  "name": "zkube",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --port 5175",
    "build": "tsc -b && vite build",
    "server:build": "pnpm --dir ../services build",
    "server:keeper": "pnpm --dir ../services start:keeper",
    "deploy:build": "node tools/deployment-build.mjs",
    "chain:devnet:deploy": "tsx tools/chain/deploy-devnet.ts",
    "chain:devnet:extend": "tsx tools/chain/extend-devnet-program.ts",
    "chain:devnet:bootstrap": "tsx tools/chain/bootstrap-devnet.ts",
    "chain:manifest": "tsx tools/chain/check-deployment-manifest.ts",
    "chain:local:validator": "mb-test-validator --reset --ledger ../.localnet/ledger --bpf-program Apyuy9VZvg7DLcQhe6KGv3sw2MNzriMjtCx2q7zac1QR ../target/deploy/solana.so",
    "chain:local:test-funded-cpi": "tsx tools/chain/test-funded-self-cpi.ts",
    "chain:local:stack": "mb-stack --reset --ledger ../.localnet/ledger --bpf-program Apyuy9VZvg7DLcQhe6KGv3sw2MNzriMjtCx2q7zac1QR ../target/deploy/solana.so",
    "chain:local:er": "ephemeral-validator --no-tui --reset --remotes http://127.0.0.1:8899 --remotes ws://127.0.0.1:8900 --listen 127.0.0.1:7799 --lifecycle ephemeral",
    "chain:local:vrf": "vrf-oracle --rpc-url http://127.0.0.1:8899 --websocket-url ws://127.0.0.1:8900 --skip-preflight",
    "typecheck:chain": "tsc -p tsconfig.chain.json --pretty false",
    "idl:sync": "node tools/sync-anchor-idl.mjs",
    "idl:check": "node tools/sync-anchor-idl.mjs --check",
    "twa:configure-links": "node tools/configure-twa-links.mjs",
    "lint": "cd .. && client/node_modules/.bin/eslint \"client/src/**/*.{ts,tsx}\" \"client/tools/**/*.{ts,mjs}\" \"client/*.{ts,js,mjs}\" \"services/src/**/*.ts\" \"services/tests/**/*.ts\" --config client/eslint.config.js --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@anchor-lang/core": "1.0.2",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.15.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@solana-mobile/wallet-standard-mobile": "^0.5.3",
    "@solana/wallet-standard-features": "^1.4.0",
    "@solana/web3.js": "^1.98.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "bn.js": "5.2.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "howler": "^2.2.4",
    "lucide-react": "^0.394.0",
    "motion": "^12.34.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@magicblock-labs/ephemeral-validator": "0.13.6",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/bn.js": "5.2.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^7.3.1",
    "vite-plugin-mkcert": "^1.17.5",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "overrides": {
      "ws": "^8.17.1"
    }
  }
}
