  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/bn.js": "5.2.0",
    "@types/node": "^22.15.0",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "tsx": "4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "^3.2.4"
  }
