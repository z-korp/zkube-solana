{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@anchor-lang/core": ["node_modules/@anchor-lang/core"],
      "@magicblock-labs/*": ["node_modules/@magicblock-labs/*"],
      "@solana/web3.js": ["node_modules/@solana/web3.js"],
      "bn.js": ["node_modules/bn.js"]
    },
    "types": ["node", "bn.js"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "node_modules", "dist"]
}
