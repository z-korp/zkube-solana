# Server-only paymaster configuration. PAYMASTER_SECRET_KEY belongs in the
# deployment platform's secret manager and must never be committed.
SOLANA_DEVNET_RPC_URL=https://rpc.magicblock.app/devnet
PAYMASTER_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
PAYMASTER_SECRET_KEY=<set-in-secret-manager>
# Development-only alternative used by `pnpm dev`; rejected in production.
PAYMASTER_KEYPAIR_PATH=../.devnet/zkube-paymaster.json

# Sanitized deployment-manifest identity. Production Vercel builds fail unless
# ZKUBE_DEPLOYMENT_MANIFEST points to an approved manifest matching these values.
# The live program deployment alone does not make this full runtime manifest
# approved. Its public evidence is artifacts/devnet-program-deployment.proof.json:
# fingerprint 35b837ec99cde6bb; deployed 2026-07-11T14:31:13Z; proof SHA-256
# 620b14cad362ebbf5fd0ad23075d2da3f673b11f19454e14a1e0a835688c7b3d.
ZKUBE_DEPLOYMENT_MANIFEST=<approved-sanitized-manifest.json>
ZKUBE_CLUSTER=devnet
ZKUBE_APPROVAL_STATUS=<candidate-or-approved>
ZKUBE_APPROVAL_FINGERPRINT=<approved-16-hex-fingerprint>
ZKUBE_APPROVED_AT=<iso-timestamp>
ZKUBE_APPROVAL_EVIDENCE_SHA256=<sanitized-proof-sha256>
ZKUBE_PROGRAM_ARTIFACT_SHA256=1a6f1dd87811eabf7213433e3d49e104212e19b76df67cb6a3828d8a8c15161a
ZKUBE_DEPLOYMENT_SIGNATURE=bkhBvwRimF6xQHLbMDt5ULcQfb4sghbraK7Jdw4a3gS3t6sT3WNobDsyL5httCWBFxNVEzfHmj6k4aSb7uRCwKj
ZKUBE_DEPLOYED_AT=2026-07-11T14:31:13Z
ZKUBE_PAYMENT_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
ZKUBE_PAYMENT_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
