{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.reboot.tsbuildinfo",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/vite-env.d.ts",
    "src/server/**/*.ts",
    "src/solana/constants.ts",
    "src/solana/idl.ts",
    "src/solana/generated/**/*.ts",
    "src/solana/reboot/**/*.ts",
    "src/ui/pages/RebootPlayScreen.tsx",
    "src/ui/pages/RebootDailyChallengePage.tsx"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "node_modules", "dist"]
}
